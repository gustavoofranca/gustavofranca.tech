{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "4321",
      "url": ["http://localhost:4321/"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": { "categories:accessibility": ["error", { "minScore": 1 }] }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
