---
import SectionTitle from "@/components/home/SectionTitle.astro";
import { getStack, usedIn } from "@/lib/content";
import { formatList, t, type Locale } from "@/lib/i18n";
import { routePath } from "@/lib/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const stack = await getStack();

// Na home só entra o que tem prova: tecnologia usada em algum projeto publicado.
// A stack completa fica no Sobre.
const areas = (
  await Promise.all(
    stack.areas.map(async (area) => ({
      id: area.id,
      label: area.label[locale],
      items: (
        await Promise.all(
          area.items.map(async (item) => ({
            name: item.name,
            projects: (await usedIn(item.id, locale)).map((p) => p.title),
          })),
        )
      ).filter((item) => item.projects.length > 0),
    })),
  )
).filter((area) => area.items.length > 0);
---

<section
  aria-labelledby="stack-title"
  class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6 md:pb-24"
>
  <div class="flex items-center justify-between gap-4">
    <SectionTitle id="stack-title" label={dict.sections.stack} />
    <a
      href={routePath("about", locale)}
      class="inline-flex min-h-10 items-center rounded-(--radius-control) text-sm text-muted transition-colors duration-(--duration-fast) hover:text-fg"
    >
      {dict.home.fullStack}
    </a>
  </div>
  <div class="mt-4 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {areas.map((area) => (
      <div>
        <h3 class="text-base font-medium">{area.label}</h3>
        <ul class="mt-3 flex flex-col gap-3">
          {area.items.map((item) => (
            <li>
              <span translate="no" class="font-mono text-sm text-fg">
                {item.name}
              </span>
              <p class="text-sm text-faint">
                {dict.stack.usedIn} {formatList(item.projects, locale)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
