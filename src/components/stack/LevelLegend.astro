---
import LevelDot from "@/components/stack/LevelDot.astro";
import { t, type Locale } from "@/lib/i18n";
import { STACK_LEVELS } from "@/lib/stack";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale).stack;
---

<ul
  aria-label={dict.levelLegend}
  data-testid="level-legend"
  class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted"
>
  {STACK_LEVELS.map((level) => (
    <li class="flex items-center gap-1.5">
      <LevelDot level={level} locale={locale} withText={false} />
      {dict.levels[level]}
    </li>
  ))}
</ul>
