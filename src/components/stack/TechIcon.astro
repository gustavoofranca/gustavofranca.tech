---
import { getIconSprite } from "@/lib/content";
import { iconSymbolId } from "@/lib/iconSprite";
import { resolveTechIcon } from "@/lib/techIcons";

interface Props {
  // Slug do Simple Icons ou "lucide:<nome>". Sem slug, o espaço fica reservado
  // para o nome alinhar com os itens que têm ícone.
  slug?: string | undefined;
}

const { slug } = Astro.props;
if (slug !== undefined && !resolveTechIcon(slug)) {
  throw new Error(
    `TechIcon: o ícone "${slug}" não existe no Simple Icons nem em src/lib/genericIcons.ts.`,
  );
}
// O traçado mora no sprite externo (cacheável); aqui vai só a referência. A cor vem
// de `text-muted` e chega ao <symbol> pelo currentColor.
const href =
  slug === undefined
    ? undefined
    : `${(await getIconSprite()).href}#${iconSymbolId(slug)}`;
---

{href ? (
  <svg aria-hidden="true" focusable="false" class="size-4 shrink-0 text-muted">
    <use href={href} />
  </svg>
) : (
  <span aria-hidden="true" class="size-4 shrink-0" />
)}
