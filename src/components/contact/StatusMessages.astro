---
import type { Locale } from "@/i18n/locales";
import { t } from "@/lib/i18n";
import { CONTACT_EMAIL } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { form } = t(locale).contact;
const withEmail = (text: string) => text.replace("{email}", CONTACT_EMAIL);

// Resultado do envio sem JS. A página é estática e não lê ?status no servidor; a API
// redireciona com uma âncora (#contato-enviado, #contato-erro-<motivo>) e o CSS
// :target mostra só a mensagem certa. Funciona com JS desligado e sem script inline.
const messages = [
  { id: "contato-enviado", text: form.success, error: false },
  { id: "contato-erro-invalid", text: form.errors.invalid, error: true },
  {
    id: "contato-erro-captcha",
    text: withEmail(form.errors.captcha),
    error: true,
  },
  {
    id: "contato-erro-rate_limited",
    text: form.errors.tooManyRequests,
    error: true,
  },
  // spam e falha de envio: a mesma mensagem genérica (não ensina o robô).
  {
    id: "contato-erro-spam",
    text: withEmail(form.errors.generic),
    error: true,
  },
  {
    id: "contato-erro-send_failed",
    text: withEmail(form.errors.generic),
    error: true,
  },
];
---

{messages.map((message) => (
  <p
    id={message.id}
    tabindex="-1"
    data-testid="contact-status"
    class:list={[
      "mb-6 hidden scroll-mt-24 rounded-(--radius-control) border px-4 py-3 text-sm font-medium outline-none target:block",
      message.error ? "border-accent text-accent" : "border-line text-fg",
    ]}
  >
    {message.text}
  </p>
))}
