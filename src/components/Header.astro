---
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { Locale } from "@/i18n/locales";
import { getProjects, projectSlug } from "@/lib/content";
import { t } from "@/lib/i18n";
import { alternatePath, matchRoute, routePath } from "@/lib/routes";

interface Props {
  locale: Locale;
  path: string;
  // Só mostra o botão ⌘K quando a página monta a ilha da paleta.
  palette: boolean;
}

const { locale, path, palette } = Astro.props;
const dict = t(locale);
const other: Locale = locale === "pt" ? "en" : "pt";

// Só vale trocar para o projeto se ele existe no outro idioma. Ler os getters aqui
// também faz todo build validar o conteúdo (pares PT/EN, destaques, stack).
const otherSlugs = new Set(
  (await getProjects(other)).map((project) => projectSlug(project.id)),
);
const hrefs = {
  [locale]: path,
  [other]: alternatePath(path, other, otherSlugs),
} as Record<Locale, string>;

const current = matchRoute(path)?.key;
const links = [
  { label: dict.nav.projects, key: "projects" },
  { label: dict.nav.about, key: "about" },
  { label: dict.nav.contact, key: "contact" },
] as const;

// Sem JS (antes do ThemeScript definir data-theme) estes controles não fariam nada.
const needsJs = "[html:not([data-theme])_&]:hidden";
---

{/* Nome de view transition: na troca de página o cabeçalho fica parado (global.css). */}
<header class="border-b border-line [view-transition-name:site-header]">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2 sm:px-6">
    <a
      href={routePath("home", locale)}
      aria-label={dict.a11y.homeLink}
      class="inline-flex min-h-10 items-center rounded-(--radius-control) font-mono text-base text-fg"
    >
      <span class="text-accent" aria-hidden="true">
        ~/
      </span>
      gustavo
    </a>

    <nav
      aria-label={dict.a11y.mainNav}
      class="order-last w-full sm:order-none sm:w-auto"
    >
      {/* Sublinhado de luz (H2): cresce da esquerda no hover e no foco, e fica cheio na
          página atual, que assim não depende só da cor do texto. */}
      <ul class="flex items-center gap-1 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={routePath(link.key, locale)}
              aria-current={
                current === link.key ||
                (current === "project" && link.key === "projects")
                  ? "page"
                  : undefined
              }
              class="relative inline-flex min-h-10 items-center rounded-(--radius-control) px-3 text-muted transition-colors duration-(--duration-fast) after:pointer-events-none after:absolute after:inset-x-3 after:bottom-2 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-(--duration-base) after:ease-(--ease-out-expo) hover:text-fg focus-visible:after:scale-x-100 hover-fine:after:scale-x-100 aria-[current=page]:text-fg aria-[current=page]:after:scale-x-100"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitch locale={locale} hrefs={hrefs} />
      {palette && (
        <button
          type="button"
          data-open-palette
          aria-keyshortcuts="Meta+K Control+K"
          class:list={[
            "inline-flex h-10 items-center rounded-(--radius-control) border border-line px-3 font-mono text-sm text-muted transition-colors duration-(--duration-fast) hover:text-fg",
            needsJs,
          ]}
        >
          {/* Nome pelo texto oculto, não por aria-label: o "⌘K" visível é símbolo e
              não casaria com o nome (WCAG 2.5.3); o atalho vai em aria-keyshortcuts. */}
          <span class="sr-only">{dict.palette.open}</span>
          <kbd aria-hidden="true" class="font-mono">
            ⌘K
          </kbd>
        </button>
      )}
      <span class={needsJs}>
        <ThemeToggle label={dict.theme.toggle} />
      </span>
    </div>
  </div>
</header>

<script>
  // A paleta ⌘K escuta este evento; o botão só pede para abrir. A ilha hidrata
  // depois do load (client:afterload): um clique antes disso não tem ouvinte. Por isso
  // o pedido também fica marcado no <html>; a ilha confere a marca ao montar, abre e
  // apaga (CommandPalette.tsx). Se já estiver montada, o evento abre e apaga a marca.
  document.querySelectorAll("[data-open-palette]").forEach((button) => {
    button.addEventListener("click", () => {
      document.documentElement.dataset.paletteRequested = "";
      window.dispatchEvent(new CustomEvent("gf:open-palette"));
    });
  });
</script>
