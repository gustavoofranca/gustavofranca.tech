---
import type { Locale } from "@/i18n/locales";
import { t } from "@/lib/i18n";
import { routePath } from "@/lib/routes";
import { GITHUB_URL } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
const linkClass =
  "inline-flex min-h-10 items-center rounded-(--radius-control) text-muted transition-colors duration-(--duration-fast) hover:text-fg";
---

<footer class="border-t border-line">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      {`© ${year} ${dict.meta.siteName}. ${dict.footer.rights}`}
      <span class="text-faint">{dict.footer.builtWith}</span>
    </p>
    <ul class="flex items-center gap-4">
      <li>
        <a href={routePath("privacy", locale)} class={linkClass}>
          {dict.footer.privacy}
        </a>
      </li>
      <li>
        <a href={GITHUB_URL} rel="noopener noreferrer" class={linkClass}>
          GitHub
        </a>
      </li>
    </ul>
  </div>
</footer>
