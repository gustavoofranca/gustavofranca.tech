---
import { join } from "node:path";
import { getAbout } from "@/lib/content";
import { CV_HREF, hasCv } from "@/lib/cv";
import { t, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const about = await getAbout();
// Decidido no build, como no hero: sem o PDF em public/ o link levaria a um 404.
const showCv = hasCv(join(process.cwd(), "public"));
---

<header class="mx-auto w-full max-w-5xl px-4 pt-12 pb-12 sm:px-6 md:pt-16 md:pb-16">
  <h1 class="text-4xl font-semibold tracking-tight">{dict.about.title}</h1>
  <div class="mt-5 flex max-w-[70ch] flex-col gap-4 text-lg text-muted">
    {about.story.map((paragraph) => (
      <p>{paragraph[locale]}</p>
    ))}
  </div>
  {showCv && (
    <a
      href={CV_HREF}
      download
      class="mt-8 inline-flex min-h-10 items-center rounded-(--radius-control) border border-line px-4 text-sm font-medium text-fg transition-colors duration-(--duration-fast) hover:border-faint"
    >
      {dict.hero.downloadCv}
    </a>
  )}
</header>
