---
import SectionTitle from "@/components/home/SectionTitle.astro";
import { getExperience } from "@/lib/content";
import { formatMonth, t, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
// getExperience já vem do início mais recente para o mais antigo.
const entries = await getExperience();
// Término no futuro (formatura) é previsão, não fato consumado.
const currentMonth = new Date().toISOString().slice(0, 7);
---

<section
  aria-labelledby="timeline-title"
  class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6 md:pb-24"
>
  <SectionTitle id="timeline-title" label={dict.sections.timeline} />
  <ol class="mt-4 max-w-2xl border-l border-line">
    {entries.map(({ data }) => (
      <li data-testid="timeline-item" class="relative pb-10 pl-6 last:pb-0">
        <span
          aria-hidden="true"
          class="absolute top-2 -left-[5px] size-2.5 rounded-full border border-faint bg-bg"
        />
        <p class="font-mono text-sm text-faint">
          <time datetime={data.start} data-role="start">
            {formatMonth(data.start, locale)}
          </time>
          {" – "}
          {data.end ? (
            <>
              <time datetime={data.end}>{formatMonth(data.end, locale)}</time>
              {data.end > currentMonth && ` (${dict.about.expected})`}
            </>
          ) : (
            dict.home.present
          )}
          {" · "}
          {dict.about.kinds[data.kind]}
        </p>
        <h3 class="mt-1 text-base font-medium">{data.role[locale]}</h3>
        <p class="text-sm text-muted">{data.org}</p>
        <p class="mt-2 max-w-prose text-sm text-muted">
          {data.description[locale]}
        </p>
      </li>
    ))}
  </ol>
</section>
