---
import SectionTitle from "@/components/home/SectionTitle.astro";
import LevelLegend from "@/components/stack/LevelLegend.astro";
import StackItemName from "@/components/stack/StackItemName.astro";
import { getStackAreas } from "@/lib/content";
import { formatList, t, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
// O nível é o ponto ao lado do nome (definido pelo Gustavo em stack.json); a prova
// continua sendo "usado em". Tecnologia sem projeto publicado aparece só com o
// nome, sem inventar onde foi usada.
const areas = await getStackAreas(locale);
---

<section
  aria-labelledby="stack-title"
  class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6 md:pb-24"
>
  <SectionTitle id="stack-title" label={dict.sections.stack} />
  <LevelLegend locale={locale} />
  <div class="mt-4 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {areas.map((area) => (
      <div>
        <h3 class="text-base font-medium">{area.label}</h3>
        <ul class="mt-3 flex flex-col gap-3">
          {area.items.map((item) => (
            <li data-testid="stack-item">
              <StackItemName
                name={item.name}
                brand={item.brand}
                icon={item.icon}
                level={item.level}
                locale={locale}
              />
              {item.projects.length > 0 && (
                <p class="pl-6 text-sm text-faint">
                  {dict.stack.usedIn} {formatList(item.projects, locale)}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
