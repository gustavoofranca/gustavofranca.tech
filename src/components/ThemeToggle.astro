---
// Botão de tema sem React: não tem estado (o tema vive no data-theme do <html>,
// definido antes da pintura, e o ícone troca por CSS). Como ilha client:load ele
// puxava o runtime do React (~65 KB gzip) na abertura de toda página, disputando
// banda com CSS, fontes e a imagem do LCP. O React agora só chega com a paleta
// (client:afterload, depois do load). Orçamento: .claude/rules/qualidade.md
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  class="inline-flex size-10 items-center justify-center rounded-(--radius-control) border border-line text-muted transition-colors duration-(--duration-fast) hover:text-fg"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden [html[data-theme=dark]_&]:block"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden [html[data-theme=light]_&]:block"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  import { toggleTheme } from "@/lib/theme";

  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => toggleTheme());
  });
</script>
