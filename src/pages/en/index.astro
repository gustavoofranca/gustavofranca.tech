---
import ContactCta from "@/components/home/ContactCta.astro";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import Hero from "@/components/home/Hero.astro";
import MiniTimeline from "@/components/home/MiniTimeline.astro";
import StackSection from "@/components/stack/StackSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/lib/i18n";
import { personJsonLd } from "@/lib/seo";

const locale = "en";
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  title=""
  description={dict.meta.homeDescription}
  path="/en/"
  jsonLd={[personJsonLd(locale)]}
>
  <Hero locale={locale} />
  <FeaturedProjects locale={locale} />
  <StackSection locale={locale} variant="home" />
  <MiniTimeline locale={locale} />
  <ContactCta locale={locale} />
</BaseLayout>
