---
import ContactPage from "@/components/contact/ContactPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TURNSTILE_ORIGIN } from "@/lib/csp";
import { t } from "@/lib/i18n";

const locale = "en";
const dict = t(locale);
// Exceção da CSP só nas páginas de contato: o widget do Turnstile (script + iframe).
// Fica na página, não no ContactPage: a <meta> sai antes de os componentes filhos rodarem.
Astro.csp?.insertScriptResource(TURNSTILE_ORIGIN);
Astro.csp?.insertDirective(`frame-src ${TURNSTILE_ORIGIN}`);
---

<BaseLayout
  locale={locale}
  title={dict.contact.title}
  description={dict.meta.contactDescription}
  path="/en/contact"
>
  <ContactPage locale={locale} />
</BaseLayout>
