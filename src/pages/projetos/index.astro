---
import ProjectsIndex from "@/components/projects/ProjectsIndex.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/lib/i18n";

const locale = "pt";
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  title={dict.projects.title}
  description={dict.meta.projectsDescription}
  path="/projetos"
>
  <ProjectsIndex locale={locale} />
</BaseLayout>
