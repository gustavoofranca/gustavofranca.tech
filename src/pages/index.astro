---
import { ThemeToggle } from "@/components/islands/ThemeToggle";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/lib/i18n";

const locale = "pt";
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  title="Gustavo França"
  description="Portfólio de Gustavo França, desenvolvedor."
  path="/"
>
  <main class="p-6">
    <h1 class="text-3xl font-semibold">Gustavo França</h1>
    <!-- client:load: o botão precisa responder já no primeiro toque; o cabeçalho real vem na Task 6. -->
    <ThemeToggle client:load label={dict.theme.toggle} />
  </main>
</BaseLayout>
