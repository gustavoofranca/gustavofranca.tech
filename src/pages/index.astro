---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/lib/i18n";
import { personJsonLd } from "@/lib/seo";

// Provisório: a home de verdade chega na Task 7.
const locale = "pt";
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  title=""
  description={dict.meta.homeDescription}
  path="/"
  jsonLd={[personJsonLd(locale)]}
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl font-semibold">{dict.meta.siteName}</h1>
  </section>
</BaseLayout>
