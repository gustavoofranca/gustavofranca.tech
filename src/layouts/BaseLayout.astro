---
import ThemeScript from "@/components/ThemeScript.astro";
import type { Locale } from "@/i18n/locales";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  jsonLd?: object[];
}

const { locale, title, description } = Astro.props;
const htmlLang = locale === "pt" ? "pt-BR" : "en";
// Esqueleto: canonical, hreflang, Open Graph e JSON-LD (path, ogImage, jsonLd) entram na Task 6.
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ThemeScript />
  </head>
  <body class="bg-bg text-fg font-sans antialiased">
    <slot />
  </body>
</html>
