---
import Seo from "@/components/Seo.astro";
import Shell from "@/components/Shell.astro";
import ThemeScript from "@/components/ThemeScript.astro";
import type { Locale } from "@/i18n/locales";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  jsonLd?: object[];
  noindex?: boolean;
  // A 404 monta o próprio cabeçalho e rodapé nos dois idiomas.
  shell?: boolean;
}

const { locale, shell = true, ...seo } = Astro.props;
const htmlLang = locale === "pt" ? "pt-BR" : "en";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo locale={locale} {...seo} />
    <ThemeScript />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-sans text-fg antialiased">
    {shell ? (
      <Shell locale={locale} path={seo.path}>
        <slot />
      </Shell>
    ) : (
      <slot />
    )}
  </body>
</html>
